# Local development. Copy to .env at the repository root. For the production
# environment on Dokploy see .env.example.

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=3001
DATABASE_URL=postgres://ucch:ucch@localhost:5432/ucch

# The shared servers projects' development databases are created on, as the
# unprivileged `dev` account (see docker-compose.dev.yml). Unset leaves the
# engine unavailable in the New project dialog's database option.
DEV_POSTGRES_URL=postgres://dev:dev@localhost:55432/dev
DEV_MYSQL_URL=mysql://dev:dev@localhost:53306/dev

# --- Public addressing ------------------------------------------------------
# Every public URL derives from this. Locally, *.ucch.localhost resolves to
# 127.0.0.1 automatically on Linux, so no hosts-file entry is needed.
ROOT_DOMAIN=ucch.localhost
PUBLIC_SCHEME=http
# Live previews are served on p{port}-{hash}.ROOT_DOMAIN by the API server
# itself. With nothing in front of it, the URL needs the server's port; behind
# Traefik (docker-compose) leave this unset.
PUBLIC_PREVIEW_PORT=3001
# Where a preview visitor is sent to sign in. Defaults to ROOT_DOMAIN, which
# is right in production; in development the web app is on localhost:3000.
PUBLIC_WEB_ORIGIN=http://localhost:3000

# --- Workspaces -------------------------------------------------------------
WORKSPACE_ROOT=/srv/ucch/workspaces

# --- Attachments ------------------------------------------------------------
# Files attached in the composer are staged in WORKSPACE_ROOT/.uploads, outside
# every project's working directory, until the agent's attach_upload tool -- or
# POST /api/projects/:hash/uploads/:id/attach -- moves one in. Anything nobody
# placed within the TTL is swept.
UPLOAD_MAX_BYTES=26214400
UPLOAD_TTL_HOURS=24

# --- Agent ------------------------------------------------------------------
ANTHROPIC_API_KEY=

# The model that summarises rather than works: web_search reading result
# pages, and the compaction pass that folds a long thread down so it keeps
# fitting. Deliberately not the coding model -- these are the two cheapest
# things a model is asked to do here, and billing them at the coding rate
# made a single search cost about as much as a turn of real work.
SEARCH_MODEL=google/gemini-2.5-flash

# --- Dictation --------------------------------------------------------------
# The composer's mic uses the browser's own speech recognition where it has
# one (Chrome, Edge, Safari). Elsewhere (Firefox) it records a clip and sends
# it to an audio-capable OpenRouter model, billed to the user's own key
# (Settings -> Providers). Blank: google/gemini-2.5-flash.
TRANSCRIBE_MODEL=

# --- Research ---------------------------------------------------------------
# The pipeline behind the composer's "+ > Research" toggle, in escalation order:
#   1. Perplexity Sonar (via OpenRouter, billed to the user's key) finds live
#      information, URLs and summaries;
#   2. Crawl4AI reads the pages -- the fast, high-throughput path;
#   3. a Browser Use agent takes the pages the crawler cannot get past (bot
#      checks, login walls, interactive apps).
# Run Crawl4AI with:  docker run -d -p 11235:11235 --shm-size=1g unclecode/crawl4ai
# Leave CRAWL4AI_URL empty to run without a reader, and BROWSER_USE_API_KEY
# empty to run without the escalation agent; the tools say so when asked.
RESEARCH_SEARCH_MODEL=perplexity/sonar
CRAWL4AI_URL=http://127.0.0.1:11235
CRAWL4AI_API_TOKEN=
BROWSER_USE_API_KEY=
# BROWSER_USE_API_URL=https://api.browser-use.com

# Documentation mode: the interpreter with python-docx, pypdf, pdfplumber and
# vl-convert-python (see "Documentation" in README.md), and the vision model
# that reads page renders and figures. pandoc 3, typst, poppler-utils,
# LibreOffice, graphviz and mermaid-cli are found on PATH.
DOC_PYTHON=python3
DOC_VISION_MODEL=google/gemini-2.5-flash

# Hard stop on the agent's tool-calling loop, surfaced as
# stopReason: "max_iterations" rather than as a failure.
AGENT_MAX_ITERATIONS=25

# Permits the `shell` plugin (bash on the host, as the server user) when
# NODE_ENV=production. Until the container runtime lands this is remote code
# execution by whichever model is selected, so it must be chosen explicitly.
# In development the plugin loads without it.
AGENT_ALLOW_HOST_SHELL=false

# --- Agent providers (Claude Code / Codex CLIs) ------------------------------
# Per-user CLI credential directories live at {CREDS_ROOT}/{userId}/{claude,codex}
# (CLAUDE_CONFIG_DIR / CODEX_HOME). Mode 0700. Exclude this path from backups.
# The CLI providers are held to the same AGENT_ALLOW_HOST_SHELL gate as bash.
CREDS_ROOT=/srv/ucch/creds
# Installed runtime versions (PHP today), shared by every project; each project
# picks one in Manage -> Runtimes. Unset: `runtimes` beside CREDS_ROOT.
# RUNTIMES_ROOT=/srv/ucch/runtimes
# Download the newest PHP at boot, and a version a project asks for, by itself.
# RUNTIMES_AUTO_INSTALL=true
# CLI-provider turns one account may run at once (one subscription, one human).
AGENT_MAX_CONCURRENT_PER_USER=2
# The vendor binaries; bare names resolve through the server's PATH.
CLAUDE_BIN=claude
CODEX_BIN=codex

# --- OMP (oh-my-pi), the "Custom" provider -----------------------------------
# documentation/omp/solution.md. Off until the provider ships; the native loop
# stays available for threads bound to it (NATIVE_LOOP_FALLBACK).
OMP_BIN=omp
OMP_ENABLED=false
NATIVE_LOOP_FALLBACK=true
# The omp-bridge MCP server handed to Claude Code and Codex turns (run with
# node): it carries `ucch_agent`, subagents on any harness. Leave it unset to
# use this checkout's packages/omp-bridge/dist/omp-bridge.mjs (scripts/dev.sh
# builds it); a path set here must be absolute.
# OMP_BRIDGE_BIN=
# OMP processes on the whole server (turns plus bridge calls, ~300 MB each),
# subagents per turn, and the longest a bridge call may run.
OMP_TURN_TOTAL=6
OMP_WORKERS_PER_TURN=4
OMP_BRIDGE_MAX_SECONDS=300

# --- Auth -------------------------------------------------------------------
# Skips GitHub OAuth and authenticates everyone as a fixed local user.
# loadConfig() refuses to start with this enabled when NODE_ENV=production.
DEV_AUTH_BYPASS=true

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Who may sign in with GitHub: comma-separated logins and/or org names.
# Left empty, only accounts that already exist here can sign in with GitHub.
GITHUB_ALLOWED_USERS=
GITHUB_ALLOWED_ORGS=

# Seeded on first boot so a fresh install has a way in before GitHub OAuth is
# configured. Skipped when the email already exists, so restarting never
# resets a changed password. Change this before exposing the server.
DEFAULT_USER_EMAIL=danialirfan@danialirfan.dev
DEFAULT_USER_PASSWORD=danialdev

# 32 bytes of hex for AES-256-GCM at-rest encryption of stored secrets:
#   openssl rand -hex 32
SECRET_KEY=

# --- Web --------------------------------------------------------------------
# Next's rewrites proxy /api but not WebSocket upgrades, so in development the
# browser needs the server origin directly. In production the gateway serves
# both from one origin and this is left unset.
SERVER_ORIGIN=http://127.0.0.1:3001
NEXT_PUBLIC_WS_ORIGIN=http://127.0.0.1:3001
