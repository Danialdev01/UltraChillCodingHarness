# Production environment for the UCCH Compose service on Dokploy.
#
# Paste into the service's Environment tab. Only ROOT_DOMAIN is required:
# every password and key is generated on the first deploy and kept in the
# `secrets` volume. A blank value is treated as unset. See README.md,
# "Deploying on Dokploy".
#
# For local development run `pnpm dev:up` instead (it uses
# .env.development.example).

# >>> REQUIRED: the domain the app is served on. Its A record points at the
# VPS; live previews use p{port}-{hash}.<this domain>.
ROOT_DOMAIN=ucch.example.com

# --- First sign-in (recommended) --------------------------------------------
# Created on the first boot only. Email defaults to admin@<ROOT_DOMAIN>;
# a blank password is generated -- read it with
#   docker exec <server container> cat /run/ucch-secrets/default_user_password
DEFAULT_USER_EMAIL=
DEFAULT_USER_PASSWORD=

# --- Scaling ----------------------------------------------------------------
# Web UI containers behind Traefik (stateless; raise for more traffic).
WEB_REPLICAS=2
# Set to `research` to also run the Crawl4AI crawler (~1 GB RAM) for the
# chat's Research toggle; the server finds it automatically.
COMPOSE_PROFILES=

# --- Optional ---------------------------------------------------------------

# Sign in with GitHub. OAuth App callback URL:
#   https://<ROOT_DOMAIN>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Agent models (OpenRouter ids; billed to each user's own key from Settings).
DEFAULT_MODEL=
SEARCH_MODEL=
AGENT_MAX_ITERATIONS=25
# Leave blank so the claude/codex CLI providers use each person's own
# subscription.
ANTHROPIC_API_KEY=

# Research: an external Crawl4AI server (instead of the profile above) and a
# Browser Use key, both optional.
RESEARCH_SEARCH_MODEL=
CRAWL4AI_URL=
CRAWL4AI_API_TOKEN=
BROWSER_USE_API_KEY=

# Removes the "made with tldraw" badge on notes whiteboards (build time).
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# --- Secret overrides (leave blank to auto-generate) -------------------------
# Only for moving an existing install over: the databases keep the passwords
# they were first initialised with. SECRET_KEY must be 64 hex characters and
# never change after first boot, or stored API keys become unreadable.
SECRET_KEY=
POSTGRES_PASSWORD=
MYSQL_ROOT_PASSWORD=
DEV_DB_PASSWORD=
