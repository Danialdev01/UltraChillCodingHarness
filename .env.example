# UCCH on Dokploy: paste this whole file into the application's Environment
# tab. Blank values count as unset, and every password and key left blank is
# generated on the first boot and kept in /data/secrets. See README.md,
# "Deploying on Dokploy". Local development uses .env.development.example.
#
# Dokploy, besides this tab:
#   Domains        ucch.danialirfan.dev -> port 3000, HTTPS, Let's Encrypt
#                  (and *.ucch.danialirfan.dev for live previews)
#   Volumes        a volume at /data
#   Swarm Settings Update Config -> Order: stop-first (never start-first)
#   Build-time Arguments (not here): NEXT_PUBLIC_TLDRAW_LICENSE_KEY, BUILD_ID,
#                  NEXT_PUBLIC_PWA=1

ROOT_DOMAIN=ucch.danialirfan.dev
PUBLIC_SCHEME=https

# --- First sign-in ----------------------------------------------------------
# Created on the first boot only. Blank email: admin@ucch.danialirfan.dev.
# Blank password: generated, read it with
#   cat /data/secrets/default_user_password
DEFAULT_USER_EMAIL=
DEFAULT_USER_PASSWORD=

# --- GitHub sign-in ---------------------------------------------------------
# OAuth App callback: https://ucch.danialirfan.dev/api/auth/github/callback
# With no allowed users or orgs, only existing accounts can sign in this way.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ALLOWED_USERS=
GITHUB_ALLOWED_ORGS=

# --- Agents -----------------------------------------------------------------
# OpenRouter ids, billed to each user's own key (Settings -> Providers).
# Blank: anthropic/claude-sonnet-4.5, google/gemini-2.5-flash,
# perplexity/sonar and google/gemini-2.5-flash.
DEFAULT_MODEL=
SEARCH_MODEL=
RESEARCH_SEARCH_MODEL=
DOC_VISION_MODEL=
# Blank so the claude/codex CLIs use each person's own subscription.
ANTHROPIC_API_KEY=
# The terminal, agents' bash and live previews run in the container as its
# unprivileged user. Anyone who can sign in has a shell there.
AGENT_ALLOW_HOST_SHELL=true

# Research extras, both optional: a Crawl4AI server (its own Dokploy service)
# and a Browser Use key.
CRAWL4AI_URL=
CRAWL4AI_API_TOKEN=
BROWSER_USE_API_KEY=

# --- Databases --------------------------------------------------------------
# PostgreSQL runs inside the container unless DATABASE_URL points elsewhere.
DATABASE_URL=
DEV_POSTGRES_URL=
# MariaDB for projects' MySQL databases (~150 MB of RAM).
ENABLE_MYSQL=false
DEV_MYSQL_URL=
# Sized for an 8 GB VPS. On 2-4 GB: 256MB and 768MB.
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB

# --- Monitoring -------------------------------------------------------------
# /metrics from outside the container needs a bearer token of 16+ characters.
METRICS_TOKEN=
# Alerts (memory, event-loop lag, OOM kills) POSTed as JSON, e.g. to ntfy.
ALERT_WEBHOOK_URL=
# fatal, error, warn, info, debug, trace or silent. Blank: info.
LOG_LEVEL=

# --- Migrating an existing install only -------------------------------------
# Copy these from the old /data/secrets. SECRET_KEY (64 hex characters) must
# never change after the first boot, or stored API keys become unreadable.
SECRET_KEY=
POSTGRES_PASSWORD=
DEV_DB_PASSWORD=

# Everything else has a sensible default: heap sizes, terminal and agent
# limits, the rest of the PG_* tuning, BACKUP_KEEP and so on. Their names and
# defaults are in apps/server/src/config.ts and deploy/s6/s6-rc.d/*/run.
