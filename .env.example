# Production environment for UCCH's single container (a Dokploy "Dockerfile"
# application, or `docker compose up` with docker-compose.yml).
#
# Paste into the application's Environment tab. Only ROOT_DOMAIN is required:
# every password and key is generated on the first boot and kept in
# /data/secrets. A blank value is treated as unset. See README.md,
# "Deploying on Dokploy".
#
# For local development run `pnpm dev:up` instead (it uses
# .env.development.example).

# >>> REQUIRED: the domain the app is served on. Its A record points at the
# VPS; live previews use p{port}-{hash}.<this domain>.
ROOT_DOMAIN=ucch.example.com
# https behind Dokploy/Traefik; http only for a bare local run.
PUBLIC_SCHEME=https

# --- First sign-in (recommended) --------------------------------------------
# Created on the first boot only. Email defaults to admin@<ROOT_DOMAIN>;
# a blank password is generated -- read it with
#   docker exec <container> cat /data/secrets/default_user_password
DEFAULT_USER_EMAIL=
DEFAULT_USER_PASSWORD=

# --- Databases --------------------------------------------------------------
# PostgreSQL runs inside the container. Set DATABASE_URL to use a server of
# your own instead (a Dokploy database service, say); the embedded one then
# never starts. DEV_POSTGRES_URL is where projects' databases are created.
DATABASE_URL=
DEV_POSTGRES_URL=
# MySQL-compatible dev databases for projects (MariaDB, inside the container).
# Off by default: it costs ~150 MB of RAM. Or point DEV_MYSQL_URL elsewhere.
ENABLE_MYSQL=false
DEV_MYSQL_URL=
# Embedded PostgreSQL; the defaults suit an 8 GB VPS with an SSD. On a
# 2-4 GB one, PG_SHARED_BUFFERS=256MB and PG_EFFECTIVE_CACHE_SIZE=768MB.
PG_SHARED_BUFFERS=1GB
PG_EFFECTIVE_CACHE_SIZE=3GB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=128MB
# Shared with the projects' dev servers.
PG_MAX_CONNECTIONS=200
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200
PG_JIT=off
PG_WAL_COMPRESSION=on
PG_MAX_WAL_SIZE=2GB
PG_CHECKPOINT_COMPLETION_TARGET=0.9
# A transaction left open this long (a stuck dev server's) is ended.
PG_IDLE_IN_TRANSACTION_TIMEOUT=5min
# Statements slower than this (ms) are logged; -1 turns the log off.
# scripts/pg-top.sh reads pg_stat_statements for the rest.
PG_LOG_MIN_DURATION_MS=500

# --- Optional ---------------------------------------------------------------

# Sign in with GitHub. OAuth App callback URL:
#   https://<ROOT_DOMAIN>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Who may sign in with GitHub: comma-separated logins and/or org names.
# Left empty, only accounts that already exist here can sign in with GitHub.
GITHUB_ALLOWED_USERS=
GITHUB_ALLOWED_ORGS=

# Agent models (OpenRouter ids; billed to each user's own key from Settings).
DEFAULT_MODEL=
SEARCH_MODEL=
AGENT_MAX_ITERATIONS=25
# Leave blank so the claude/codex CLI providers use each person's own
# subscription.
ANTHROPIC_API_KEY=
# The terminal, the agents' bash and live previews run inside the container
# as its unprivileged user. Anyone who can sign in has a shell there.
AGENT_ALLOW_HOST_SHELL=true

# Research: an external Crawl4AI server (run it as its own Dokploy service)
# and a Browser Use key, both optional.
RESEARCH_SEARCH_MODEL=
CRAWL4AI_URL=
CRAWL4AI_API_TOKEN=
BROWSER_USE_API_KEY=

# Documentation mode. The image sets the kit and its Python; the vision model
# reads pages for doc_inspect.
DOC_VISION_MODEL=
# Document renders (LibreOffice, Chromium, Mermaid, the kit's scripts) run at
# once across all agent turns; the rest wait for a slot.
DOC_JOBS_MAX=1

# Removes the "made with tldraw" badge on notes whiteboards (build time).
NEXT_PUBLIC_TLDRAW_LICENSE_KEY=

# Keeps this many `ucch-backup` dumps in /data/backups.
BACKUP_KEEP=7

# --- Observability ------------------------------------------------------------
# /metrics (Prometheus text). Blank: loopback only, i.e. from inside the
# container (`docker exec <container> curl -s localhost:3000/metrics`). Set a
# long random token to scrape from elsewhere with `Authorization: Bearer ...`.
METRICS_TOKEN=
# Alerts (memory above 85% of the limit for 2 min, event-loop p99 above
# 200 ms or engine wait p99 above 500 ms for 1 min, an OOM kill) are logged
# at error; with this set they are also POSTed here as JSON, the message in
# `text` (ntfy, or a Slack-compatible webhook). At most one per 15 min each.
ALERT_WEBHOOK_URL=
# Also log the per-service memory and CPU sample (every 15 s) to the
# container log.
LOG_RESOURCE_SAMPLES=false
# Heap limits (MB) of the server and of the web app. Set too low, the process
# restarts in a loop; about twice the peak under load is right.
SERVER_HEAP_MB=1536
WEB_HEAP_MB=1024
# What the server's children (CLIs, agent tool calls, dev servers) run with:
# oom_score_adj 0-1000 (higher is killed sooner) and nice 0-19. Terminals get
# at most 500 and 5; the server and Postgres keep 0.
CHILD_OOM_ADJ=800
CHILD_NICE=10
# Database connections the server opens at most.
DB_POOL_MAX=20
# Commands handled at once, each on a different project (one project's run in
# order). At most DB_POOL_MAX - 4, or the server refuses to start.
ENGINE_MAX_PARALLEL=8
# Log level (fatal, error, warn, info, debug, trace, silent). Blank: info in
# production, debug otherwise. Requests are logged only when slower than
# LOG_SLOW_MS or answered with a 5xx; /metrics counts them all.
LOG_LEVEL=
LOG_SLOW_MS=1000
# How long a turn's streamed tokens are held to go out as one frame, in ms.
STREAM_FLUSH_MS=40
# Thread events kept in memory for agents' context, across all threads. The
# least recently used thread goes first; a thread longer than half of this is
# read from the database each turn instead.
HISTORY_CACHE_EVENTS=20000
# Terminals open at once: in one project, for one person, and on the whole
# server. Over a limit the terminal says so instead of opening. A terminal
# nobody types into for TERMINAL_IDLE_MINUTES is closed.
TERMINAL_MAX_PER_PROJECT=10
TERMINAL_MAX_PER_USER=5
TERMINAL_MAX_TOTAL=40
TERMINAL_IDLE_MINUTES=15
# Agent turns running at once: CLI turns (claude, codex) per account and on
# the whole server, and native turns on the whole server. Over a limit a turn
# waits for a slot and the thread says how many are ahead.
AGENT_MAX_CONCURRENT_PER_USER=2
AGENT_MAX_CONCURRENT_TOTAL=5
AGENT_MAX_NATIVE_TOTAL=32

# --- Secret overrides (leave blank to auto-generate) -------------------------
# Only for moving an existing install over: the database keeps the passwords
# it was first initialised with. SECRET_KEY must be 64 hex characters and
# never change after first boot, or stored API keys become unreadable --
# copy it from the old stack's secrets volume when migrating.
SECRET_KEY=
POSTGRES_PASSWORD=
DEV_DB_PASSWORD=
