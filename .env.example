# Production environment for the `ucch-server` application on Dokploy.
#
# Paste this whole file into the server application's Environment tab
# (Dokploy accepts the dotenv format as-is), then fill in every line marked
#   >>> CUSTOMIZE
# Everything else is correct for https://ucch.danialirfan.dev as deployed
# from apps/server/Dockerfile, and can stay exactly as written. A variable
# left blank is treated as unset.
#
# The web application takes only two values, and they go under *Build Time
# Arguments*, not Environment Variables (see the bottom of this file).
#
# For local development use .env.development.example instead.

# --- Core -------------------------------------------------------------------
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# >>> CUSTOMIZE: the "Internal Connection URL" shown on the ucch-db database
# service in Dokploy. The host is the database's App Name on dokploy-network.
DATABASE_URL=postgres://ucch:CHANGE_ME@ucch-db-xxxxxx:5432/ucch

# --- Public addressing ------------------------------------------------------
# Every public URL derives from this: the web app on ROOT_DOMAIN, the API on
# api.ROOT_DOMAIN, live previews on p{port}-{hash}.ROOT_DOMAIN.
ROOT_DOMAIN=ucch.danialirfan.dev
PUBLIC_SCHEME=https
# Leave both unset behind Traefik: previews are on 443 and the web app is on
# the root domain, which are the defaults.
# PUBLIC_PREVIEW_PORT=
# PUBLIC_WEB_ORIGIN=

# --- Storage ----------------------------------------------------------------
# Both are bind mounts on the server application (Advanced -> Mounts) so
# project working trees and CLI logins survive a redeploy.
WORKSPACE_ROOT=/srv/ucch/workspaces
CREDS_ROOT=/srv/ucch/creds
# Reserved for the container runtime; unused today.
PREVIEW_ROOT=/srv/ucch/previews
PROJECT_NETWORK=ucch-projects
BASE_IMAGE=ucch/base:latest
IDLE_STOP_MINUTES=30

# --- Attachments ------------------------------------------------------------
# Files attached in the composer are staged in WORKSPACE_ROOT/.uploads until
# the agent moves one into a project. Unplaced files are swept after the TTL.
UPLOAD_MAX_BYTES=26214400
UPLOAD_TTL_HOURS=24

# --- Auth -------------------------------------------------------------------
# Must stay false in production; the server refuses to boot otherwise.
DEV_AUTH_BYPASS=false

# >>> CUSTOMIZE: exactly 64 hex characters. Encrypts stored API keys and
# tokens at rest and signs preview cookies. Generate once and never rotate
# casually -- stored secrets become unreadable.  openssl rand -hex 32
SECRET_KEY=

# >>> CUSTOMIZE: the first account, created on the first boot only. Use a
# real password; this is a sign-in on the public internet.
DEFAULT_USER_EMAIL=danialirfan@danialirfan.dev
DEFAULT_USER_PASSWORD=

# >>> CUSTOMIZE (optional): sign in with GitHub. Create an OAuth App with
#   Homepage URL   https://ucch.danialirfan.dev
#   Callback URL   https://ucch.danialirfan.dev/api/auth/github/callback
# The callback is on the root domain, not api., so the session cookie is
# set first-party. Leave both blank to use password sign-in only.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Agent ------------------------------------------------------------------
# The terminal, the agents' bash tool, the CLI providers and the live
# preview's dev servers all run inside the server container until the
# container runtime lands. Production refuses them without this. It means
# anyone who can sign in has a shell in the container: single-tenant only.
AGENT_ALLOW_HOST_SHELL=true

# Hard stop on the agent's tool-calling loop.
AGENT_MAX_ITERATIONS=25

# The cheap model for summarising search results and compacting long
# threads; billed to each user's own OpenRouter key (set in Settings).
SEARCH_MODEL=google/gemini-2.5-flash

# Leave blank to bill the claude/codex CLI providers to each person's own
# subscription: with a key present the CLIs prefer it and the server refuses
# to run the provider. Only set this if you want API billing for the
# built-in loop.
ANTHROPIC_API_KEY=

# --- Agent providers (Claude Code / Codex CLIs) ------------------------------
# Per-user logins live at {CREDS_ROOT}/{userId}/{claude,codex}, mode 0700.
# Exclude CREDS_ROOT from backups. The binaries are not in the image yet;
# these only matter once you add them to apps/server/Dockerfile.
AGENT_MAX_CONCURRENT_PER_USER=2
CLAUDE_BIN=claude
CODEX_BIN=codex

# --- Research ---------------------------------------------------------------
# The composer's "Research" toggle: Perplexity finds pages (via each user's
# OpenRouter key), Crawl4AI reads them, Browser Use handles what the crawler
# cannot. Both readers are optional; the tools say so when absent.
RESEARCH_SEARCH_MODEL=perplexity/sonar
# >>> CUSTOMIZE (optional): a Crawl4AI service on the same Dokploy project,
# reachable by its App Name, e.g. http://crawl4ai-xxxxxx:11235
CRAWL4AI_URL=
CRAWL4AI_API_TOKEN=
# >>> CUSTOMIZE (optional): https://browser-use.com API key.
BROWSER_USE_API_KEY=

# ============================================================================
# ucch-web application -- BUILD TIME ARGUMENTS, not Environment Variables
# ============================================================================
# Both are compiled into the build: the first into the browser bundle, the
# second into Next's rewrite table. Put them under Environment -> Build Time
# Arguments on the web application. Under Environment Variables they do
# nothing, and a wrong SERVER_ORIGIN shows as every /api/* call returning 500.
#
#   NEXT_PUBLIC_WS_ORIGIN=https://api.ucch.danialirfan.dev
#   SERVER_ORIGIN=http://ucch-server-xxxxxx:3001     <<< CUSTOMIZE: the server's App Name
#
# The web application's Environment Variables need only:
#
#   NODE_ENV=production
