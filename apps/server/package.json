{
  "name": "@ucch/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "build": "node build.mjs",
    "start:dist": "node --env-file-if-exists=../../.env --enable-source-maps dist/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cookie": "^11.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@parcel/watcher": "2.6.0",
    "@ucch/agent": "workspace:*",
    "@ucch/db": "workspace:*",
    "@ucch/protocol": "workspace:*",
    "@ucch/providers": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.0",
    "mysql2": "^3.11.0",
    "postgres": "^3.4.5",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "esbuild": "0.28.2"
  }
}
