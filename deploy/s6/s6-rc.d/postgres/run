#!/command/with-contenv bash
# PostgreSQL 16, inside the container, on loopback only.
#
# With DATABASE_URL set the harness uses that server instead, and this one
# never starts: it reports ready and idles, so the server's dependency on it
# still holds.
#
# First boot initialises /data/postgres the way the old stack's
# deploy/postgres-init.sh did: the harness's own `ucch` role and database,
# and an unprivileged `dev` role for projects' databases that may not connect
# to `ucch` -- code an agent writes and runs should never be one DROP away
# from the event log. The `postgres` superuser has no password and is
# reachable only through the local socket as the `postgres` OS user.
set -euo pipefail

if [ -n "${DATABASE_URL:-}" ]; then
  echo "[postgres] DATABASE_URL is set; the embedded server stays off" >&2
  echo >&3
  exec sleep infinity
fi

bin=/usr/lib/postgresql/16/bin
data=${DATA_DIR:-/data}/postgres
secrets=${DATA_DIR:-/data}/secrets
as_postgres() { s6-setuidgid postgres "$@"; }

if [ ! -s "$data/PG_VERSION" ]; then
  echo "[postgres] initialising $data" >&2
  as_postgres "$bin/initdb" -D "$data" --username=postgres --encoding=UTF8 --locale=C.UTF-8 \
    --auth-local=peer --auth-host=scram-sha-256 >/dev/null
  cat > "$data/pg_hba.conf" <<'HBA'
# TYPE  DATABASE  USER      ADDRESS        METHOD
local   all       postgres                 peer
local   all       all                      scram-sha-256
host    all       all       127.0.0.1/32   scram-sha-256
host    all       all       ::1/128        scram-sha-256
HBA
  chown postgres:postgres "$data/pg_hba.conf"

  as_postgres "$bin/pg_ctl" -D "$data" -w -s \
    -o "-c listen_addresses='' -c unix_socket_directories=/run/postgresql" start
  as_postgres psql -h /run/postgresql -U postgres -d postgres -v ON_ERROR_STOP=1 -q \
    -v ucch_password="$(cat "$secrets/postgres_password")" \
    -v dev_password="$(cat "$secrets/dev_db_password")" <<'SQL'
CREATE ROLE ucch LOGIN PASSWORD :'ucch_password';
CREATE DATABASE ucch OWNER ucch;
CREATE ROLE dev LOGIN CREATEDB PASSWORD :'dev_password';
CREATE DATABASE dev OWNER dev;
REVOKE CONNECT ON DATABASE ucch FROM PUBLIC;
REVOKE CONNECT ON DATABASE postgres FROM PUBLIC;
SQL
  as_postgres "$bin/pg_ctl" -D "$data" -w -s -m fast stop
  echo "[postgres] initialised" >&2
fi

# System V shared memory for parallel queries rather than /dev/shm, which a
# platform-run container gets only 64 MB of and cannot be told otherwise.
# Ready once it answers on the address the server connects to.
(
  until as_postgres "$bin/pg_isready" -h 127.0.0.1 -q; do sleep 0.3; done
  echo >&3
) &

exec 3>&- s6-setuidgid postgres "$bin/postgres" -D "$data" \
  -c listen_addresses=127.0.0.1 \
  -c unix_socket_directories=/run/postgresql \
  -c shared_buffers="${PG_SHARED_BUFFERS:-256MB}" \
  -c effective_cache_size="${PG_EFFECTIVE_CACHE_SIZE:-768MB}" \
  -c work_mem="${PG_WORK_MEM:-8MB}" \
  -c dynamic_shared_memory_type=sysv \
  -c log_min_messages=warning
