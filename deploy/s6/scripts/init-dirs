#!/command/with-contenv bash
# Lays out the one volume, /data, and hands each part to whoever owns it.
#
#   postgres/    the harness's database (and projects' dev databases)  postgres  0700
#   mysql/       projects' MySQL dev databases, when ENABLE_MYSQL      mysql     0700
#   workspaces/  project checkouts and session worktrees               node      0755
#   creds/       per-account Claude/Codex CLI logins                    node      0700
#   runtimes/    installed PHP (and later other) versions, per project  node      0755
#   secrets/     generated passwords and keys                           root      0700
#   backups/     ucch-backup's dumps                                    root      0700
#
# Terminals, agents and dev servers run as `node`: nothing of the databases'
# or the secrets' may be readable by it.
set -euo pipefail
data=${DATA_DIR:-/data}

own() {
  local dir=$1 owner=$2 mode=$3
  mkdir -p "$dir"
  # Checked at the top only, so a large workspace is not re-walked on every
  # restart; a volume from an older image is handed over once.
  if [ "$(stat -c %U "$dir")" != "$owner" ]; then
    echo "[init-dirs] giving $dir to $owner" >&2
    chown -R "$owner:$owner" "$dir"
  fi
  chmod "$mode" "$dir"
}

# /data must be a mounted volume. Without one it lives in the container's
# own layer, and the next redeploy (a new container) erases everything.
if ! mountpoint -q "$data"; then
  if [ "${ALLOW_EPHEMERAL_DATA:-false}" = "true" ]; then
    echo "[init-dirs] WARNING: $data is not a mounted volume; all data is lost when this container is replaced (ALLOW_EPHEMERAL_DATA=true)" >&2
  else
    cat >&2 <<MSG
[init-dirs] ERROR: $data is not a mounted volume.
[init-dirs] Every redeploy would start from an empty database and erase all
[init-dirs] accounts, projects and files, so the container refuses to start.
[init-dirs] Dokploy: Advanced -> Volumes -> Add Volume -> Volume Mount,
[init-dirs]          name ucch-data, mount path $data. Then redeploy.
[init-dirs] Docker:  docker run -v ucch-data:$data ...
[init-dirs] For a throwaway test run, set ALLOW_EPHEMERAL_DATA=true.
MSG
    exit 1
  fi
fi

mkdir -p "$data"
# Written on first boot: its absence means this volume is new, so a volume
# that was swapped or wiped shows up in the logs.
if [ ! -e "$data/.ucch-volume" ]; then
  # A volume from before this marker existed already holds a database.
  if [ ! -s "$data/postgres/PG_VERSION" ]; then
    echo "[init-dirs] NEW EMPTY DATA VOLUME at $data: first boot, starting from nothing" >&2
  fi
  date -u +%Y-%m-%dT%H:%M:%SZ > "$data/.ucch-volume"
fi
chown root:root "$data"
chmod 755 "$data"
own "$data/postgres" postgres 700
own "$data/mysql" mysql 700
own "$data/workspaces" node 755
own "$data/creds" node 700
own "$data/runtimes" node 755
own "$data/secrets" root 700
own "$data/backups" root 700
# Sockets: postgres's for local administration, mariadb's for its own.
own /run/postgresql postgres 2775
own /run/mysqld mysql 755
