#!/command/with-contenv bash
# Makes sure every secret exists as a file in /data/secrets, so a first
# deploy needs nothing but ROOT_DOMAIN. (The container's version of
# deploy/secrets.sh, which the multi-container stack ran as its own service.)
#
# A file is only written when missing: a restart keeps the values the
# databases were initialised with. A variable set in the environment wins,
# which is how an install whose passwords were chosen by hand -- or one moved
# here from the old stack, with its SECRET_KEY -- keeps them.
#
# Everything is root's alone. The services read what they need as root
# before dropping privileges (see ../s6-rc.d/server/run).
set -euo pipefail
dir=${DATA_DIR:-/data}/secrets
umask 077
mkdir -p "$dir"

random_hex() { head -c "$1" /dev/urandom | od -An -tx1 | tr -d ' \n'; }

ensure() {
  local name=$1 bytes=$2
  local value=${!name:-}
  local file
  file="$dir/$(echo "$name" | tr 'A-Z' 'a-z')"
  if [ -n "$value" ]; then
    printf '%s' "$value" > "$file"
  elif [ ! -s "$file" ]; then
    random_hex "$bytes" > "$file"
    echo "[init-secrets] generated $name" >&2
  fi
}

# 32 bytes = the 64 hex characters SECRET_KEY must be.
ensure SECRET_KEY 32
ensure POSTGRES_PASSWORD 24
ensure DEV_DB_PASSWORD 24
ensure DEFAULT_USER_PASSWORD 12

chown root:root "$dir" "$dir"/*
chmod 700 "$dir"
chmod 400 "$dir"/*
