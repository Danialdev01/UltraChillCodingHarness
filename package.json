{
  "name": "ucch",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "dev:up": "bash scripts/dev.sh",
    "dev:down": "docker compose -f docker-compose.dev.yml down; docker stop ucch-pg-dev 2>/dev/null || true",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @ucch/db generate",
    "db:migrate": "pnpm --filter @ucch/db migrate",
    "smoke:phase1": "node scripts/smoke-phase1.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "ws": "^8.18.0"
  }
}
